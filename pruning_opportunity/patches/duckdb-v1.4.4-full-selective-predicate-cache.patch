--- a/src/include/duckdb/storage/statistics/additional/nullspace_additional_stats.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/include/duckdb/storage/statistics/additional/nullspace_additional_stats.hpp	2026-11-16 21:18:28.493744234 +0100
@@ -0,0 +1,123 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/storage/statistics/additional/nullspace_additional_stats.hpp
+//
+// Hash-based partition summary for point queries that comes close to the space lower bound of
+// approximate membership (n * log2(1/eps) bits). Keys are hashed into buckets; per bucket and layer it
+// stores a nonzero vector v with a(x) . v = 0 over GF(2) or GF(3) for every key x of the bucket, and a
+// query q is pruned if a(q) . v != 0 in some layer. A non-member passes a GF(2) layer with probability
+// 1/2 and a GF(3) layer with probability 1/3, at 1 resp. log2(3) bits per key. Below one bit per key it
+// stores the empty cells of a hashed bitmap instead. Uses the same space as BloomAdditionalStats.
+// See pruning_codec.hpp.
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include <functional>
+#include "duckdb/storage/statistics/additional/additional_stats.hpp"
+#include "duckdb/storage/statistics/additional/bloom_additional_stats.hpp"
+#include "duckdb/storage/statistics/additional/occupancy_additional_stats.hpp"
+#include "duckdb/storage/statistics/additional/pruning_codec.hpp"
+#include "duckdb/common/enums/filter_propagate_result.hpp"
+#include "duckdb/common/enums/expression_type.hpp"
+#include "duckdb/common/serializer/serializer.hpp"
+#include "duckdb/common/serializer/deserializer.hpp"
+
+namespace duckdb {
+
+template <class T>
+class NullspaceAdditionalStats : public AdditionalStats<T> {
+private:
+	uint64_t words[PRUNING_CODEC_WORDS];
+
+	static inline uint64_t Hash(const T &value) {
+		return pruning_codec::Mix64((uint64_t)BloomUtil::hash(value) ^ 0x2545F4914F6CDD1DULL);
+	}
+
+public:
+	static inline const char *GetStaticName() {
+		return "nullspace";
+	}
+	inline NullspaceAdditionalStats(std::vector<T> &data) {
+		this->name = GetStaticName();
+		this->Initialise = &Initialise_implementation;
+		this->Query = &Query_implementation;
+		this->QueryRange = &QueryRange_implementation;
+		this->Size = &Size_implementation;
+		this->Serialise = &Serialise_implementation;
+		this->Deserialise = &Deserialise_implementation;
+		this->Initialise(data, this);
+		this->type = ADDITIONAL_STATS_TYPE::NULLSPACE;
+	}
+
+	inline static void Initialise_implementation(std::vector<T> &data, AdditionalStats<T> *stats) {
+		using namespace pruning_codec;
+		NullspaceAdditionalStats<T> *nstats = (NullspaceAdditionalStats<T> *)stats;
+		std::fill(nstats->words, nstats->words + PRUNING_CODEC_WORDS, 0);
+		if (data.empty()) {
+			return; // NO_INFORMATION
+		}
+		std::vector<uint64_t> hashes;
+		hashes.reserve(data.size());
+		for (T element : data) {
+			hashes.push_back(Hash(element));
+		}
+		std::sort(hashes.begin(), hashes.end());
+		hashes.erase(std::unique(hashes.begin(), hashes.end()), hashes.end());
+
+		// candidate 1: empty cells of a hashed bitmap (good below one bit per key)
+		auto occupancy = OccupancyCodec::BestPlan(hashes, PRUNING_CODEC_BUDGET_BITS);
+		long double occupied_cells = (long double)(occupancy.span_cells - occupancy.empty_cells);
+		long double occupancy_eps =
+		    std::min<long double>(1.0L, occupied_cells * OccupancyCodec::Width(occupancy.code) / 18446744073709551616.0L);
+		// candidate 2: GF(2)/GF(3) null-space vectors (near the bound from one bit per key)
+		auto nullspace = NullspaceCodec::MakePlan(hashes, PRUNING_CODEC_BUDGET_BITS);
+
+		pruning_codec::BitWriter out;
+		if (nullspace.bits <= PRUNING_CODEC_BUDGET_BITS && nullspace.expected_eps < occupancy_eps) {
+			out.Write(NULLSPACE, PRUNING_CODEC_KIND_BITS);
+			NullspaceCodec::Write(out, nullspace);
+		} else {
+			out.Write(OCCUPANCY, PRUNING_CODEC_KIND_BITS);
+			OccupancyCodec::Write(out, occupancy);
+		}
+		StoreStream(out, nstats->words);
+	}
+
+	inline static FilterPropagateResult Query_implementation(AdditionalStats<T> *stats, ExpressionType &comparison_type,
+	                                                         const T &constant) {
+		using namespace pruning_codec;
+		switch (comparison_type) {
+		case ExpressionType::COMPARE_EQUAL:
+		case ExpressionType::COMPARE_NOT_DISTINCT_FROM: {
+			NullspaceAdditionalStats<T> *nstats = (NullspaceAdditionalStats<T> *)stats;
+			pruning_codec::BitReader in(nstats->words);
+			uint64_t kind = in.Read(PRUNING_CODEC_KIND_BITS);
+			uint64_t hash = Hash(constant);
+			bool may_contain = kind == NULLSPACE   ? NullspaceCodec::MayContain(in, hash)
+			                   : kind == OCCUPANCY ? OccupancyCodec::MayContain(in, hash, hash)
+			                                       : true;
+			return may_contain ? FilterPropagateResult::NO_PRUNING_POSSIBLE : FilterPropagateResult::FILTER_ALWAYS_FALSE;
+		}
+		default:
+			return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+		}
+	}
+
+	inline static FilterPropagateResult QueryRange_implementation(AdditionalStats<T> *stats, const T &start,
+	                                                              const T &end) {
+		return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+	}
+
+	inline static size_t Size_implementation(AdditionalStats<T> *stats) {
+		NullspaceAdditionalStats<T> *nstats = (NullspaceAdditionalStats<T> *)stats;
+		return sizeof(*nstats);
+	}
+	inline static void Serialise_implementation(AdditionalStats<T> *stats, Serializer &serializer) {
+	}
+	inline static void Deserialise_implementation(AdditionalStats<T> *stats, Deserializer &deserializer) {
+	}
+};
+
+} // namespace duckdb
diff -ruN a/src/include/duckdb/storage/statistics/additional/occupancy_additional_stats.hpp b/src/include/duckdb/storage/statistics/additional/occupancy_additional_stats.hpp
--- a/src/include/duckdb/storage/statistics/additional/occupancy_additional_stats.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/include/duckdb/storage/statistics/additional/occupancy_additional_stats.hpp	2026-11-16 21:18:28.493744234 +0100
@@ -0,0 +1,179 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/storage/statistics/additional/occupancy_additional_stats.hpp
+//
+// Order-preserving partition summary for range (and point) queries: the key domain is split into
+// cells of equal width, and the occupied cells are stored as a Golomb-coded gap list. The cell width is
+// the finest one whose encoding fits in the same space as BloomAdditionalStats. A range is pruned if
+// every cell it touches is empty. See pruning_codec.hpp.
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include <functional>
+#include "duckdb/storage/statistics/additional/additional_stats.hpp"
+#include "duckdb/storage/statistics/additional/pruning_codec.hpp"
+#include "duckdb/common/enums/filter_propagate_result.hpp"
+#include "duckdb/common/enums/expression_type.hpp"
+#include "duckdb/common/serializer/serializer.hpp"
+#include "duckdb/common/serializer/deserializer.hpp"
+
+namespace duckdb {
+
+// same space as BloomAdditionalStats: 10x, 100x, 1000x the size of min/max (in 64-bit words)
+constexpr static uint32_t PRUNING_CODEC_WORDS = ADDITIONAL_STATS_SCALE_LEVEL == 0   ? 20
+                                                : ADDITIONAL_STATS_SCALE_LEVEL == 1 ? 200
+                                                                                    : 2000;
+
+namespace pruning_codec {
+
+// Order-preserving map to uint64_t; false for types without one (no pruning for those).
+template <class T>
+inline bool OrderedKey(const T &, uint64_t &) {
+	return false;
+}
+inline bool OrderedKey(const bool &value, uint64_t &key) {
+	key = value ? 1 : 0;
+	return true;
+}
+#define PRUNING_CODEC_SIGNED_KEY(TYPE)                                                                                 \
+	inline bool OrderedKey(const TYPE &value, uint64_t &key) {                                                         \
+		key = (uint64_t)(int64_t)value ^ (1ULL << 63);                                                                 \
+		return true;                                                                                                   \
+	}
+#define PRUNING_CODEC_UNSIGNED_KEY(TYPE)                                                                               \
+	inline bool OrderedKey(const TYPE &value, uint64_t &key) {                                                         \
+		key = (uint64_t)value;                                                                                         \
+		return true;                                                                                                   \
+	}
+PRUNING_CODEC_SIGNED_KEY(int8_t)
+PRUNING_CODEC_SIGNED_KEY(int16_t)
+PRUNING_CODEC_SIGNED_KEY(int32_t)
+PRUNING_CODEC_SIGNED_KEY(int64_t)
+PRUNING_CODEC_UNSIGNED_KEY(uint8_t)
+PRUNING_CODEC_UNSIGNED_KEY(uint16_t)
+PRUNING_CODEC_UNSIGNED_KEY(uint32_t)
+PRUNING_CODEC_UNSIGNED_KEY(uint64_t)
+#undef PRUNING_CODEC_SIGNED_KEY
+#undef PRUNING_CODEC_UNSIGNED_KEY
+inline bool OrderedKey(const double &value, uint64_t &key) {
+	if (value != value) {
+		key = ~0ULL; // NaN sorts last
+		return true;
+	}
+	double normalised = value == 0 ? 0.0 : value; // -0.0 == 0.0
+	uint64_t bits;
+	memcpy(&bits, &normalised, sizeof(bits));
+	key = (bits >> 63) ? ~bits : bits | (1ULL << 63);
+	return true;
+}
+inline bool OrderedKey(const float &value, uint64_t &key) {
+	return OrderedKey((double)value, key);
+}
+
+// Stats layout shared by both statistics: 2 bits of kind, then the codec stream.
+enum PruningCodecKind : uint64_t { NO_INFORMATION = 0, OCCUPANCY = 1, NULLSPACE = 2 };
+constexpr static uint64_t PRUNING_CODEC_KIND_BITS = 2;
+constexpr static uint64_t PRUNING_CODEC_BUDGET_BITS = PRUNING_CODEC_WORDS * 64 - PRUNING_CODEC_KIND_BITS;
+
+inline void StoreStream(const BitWriter &out, uint64_t *words) {
+	std::fill(words, words + PRUNING_CODEC_WORDS, 0);
+	if (out.bits > PRUNING_CODEC_WORDS * 64) {
+		return; // does not fit (cannot happen): NO_INFORMATION
+	}
+	std::copy(out.words.begin(), out.words.end(), words);
+}
+
+} // namespace pruning_codec
+
+template <class T>
+class OccupancyAdditionalStats : public AdditionalStats<T> {
+private:
+	uint64_t words[PRUNING_CODEC_WORDS];
+
+public:
+	static inline const char *GetStaticName() {
+		return "occupancy";
+	}
+	inline OccupancyAdditionalStats(std::vector<T> &data) {
+		this->name = GetStaticName();
+		this->Initialise = &Initialise_implementation;
+		this->Query = &Query_implementation;
+		this->QueryRange = &QueryRange_implementation;
+		this->Size = &Size_implementation;
+		this->Serialise = &Serialise_implementation;
+		this->Deserialise = &Deserialise_implementation;
+		this->Initialise(data, this);
+		this->type = ADDITIONAL_STATS_TYPE::OCCUPANCY;
+	}
+
+	inline static void Initialise_implementation(std::vector<T> &data, AdditionalStats<T> *stats) {
+		using namespace pruning_codec;
+		OccupancyAdditionalStats<T> *nstats = (OccupancyAdditionalStats<T> *)stats;
+		std::fill(nstats->words, nstats->words + PRUNING_CODEC_WORDS, 0);
+		std::vector<uint64_t> keys;
+		keys.reserve(data.size());
+		for (T element : data) {
+			uint64_t key;
+			if (!OrderedKey(element, key)) {
+				return; // NO_INFORMATION
+			}
+			keys.push_back(key);
+		}
+		if (keys.empty()) {
+			return;
+		}
+		std::sort(keys.begin(), keys.end());
+		keys.erase(std::unique(keys.begin(), keys.end()), keys.end());
+		auto plan = OccupancyCodec::BestPlan(keys, PRUNING_CODEC_BUDGET_BITS);
+		pruning_codec::BitWriter out;
+		out.Write(OCCUPANCY, PRUNING_CODEC_KIND_BITS);
+		OccupancyCodec::Write(out, plan);
+		StoreStream(out, nstats->words);
+	}
+
+	inline static bool MayContain(AdditionalStats<T> *stats, const T &start, const T &end) {
+		using namespace pruning_codec;
+		OccupancyAdditionalStats<T> *nstats = (OccupancyAdditionalStats<T> *)stats;
+		pruning_codec::BitReader in(nstats->words);
+		if (in.Read(PRUNING_CODEC_KIND_BITS) != OCCUPANCY) {
+			return true;
+		}
+		uint64_t lo, hi;
+		if (!OrderedKey(start, lo) || !OrderedKey(end, hi) || lo > hi) {
+			return true;
+		}
+		return OccupancyCodec::MayContain(in, lo, hi);
+	}
+
+	inline static FilterPropagateResult Query_implementation(AdditionalStats<T> *stats, ExpressionType &comparison_type,
+	                                                         const T &constant) {
+		switch (comparison_type) {
+		case ExpressionType::COMPARE_EQUAL:
+		case ExpressionType::COMPARE_NOT_DISTINCT_FROM:
+			return MayContain(stats, constant, constant) ? FilterPropagateResult::NO_PRUNING_POSSIBLE
+			                                             : FilterPropagateResult::FILTER_ALWAYS_FALSE;
+		default:
+			// one-sided comparisons are answered exactly by min/max
+			return FilterPropagateResult::NO_PRUNING_POSSIBLE;
+		}
+	}
+
+	inline static FilterPropagateResult QueryRange_implementation(AdditionalStats<T> *stats, const T &start,
+	                                                              const T &end) {
+		return MayContain(stats, start, end) ? FilterPropagateResult::NO_PRUNING_POSSIBLE
+		                                     : FilterPropagateResult::FILTER_ALWAYS_FALSE;
+	}
+
+	inline static size_t Size_implementation(AdditionalStats<T> *stats) {
+		OccupancyAdditionalStats<T> *nstats = (OccupancyAdditionalStats<T> *)stats;
+		return sizeof(*nstats);
+	}
+	inline static void Serialise_implementation(AdditionalStats<T> *stats, Serializer &serializer) {
+	}
+	inline static void Deserialise_implementation(AdditionalStats<T> *stats, Deserializer &deserializer) {
+	}
+};
+
+} // namespace duckdb
