+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/storage/table/predicate_cache.hpp
+//
+// Predicate cache (study instrumentation, not part of upstream DuckDB), after Schmidt et al., "Predicate Caching:
+// Query-Driven Secondary Indexing for Cloud Data Warehouses" (SIGMOD 2024) and ClickHouse's query condition cache.
+//
+// Enabled only when the environment variable PRUNING_PREDICATE_CACHE is set to 1/on/exact (whole-conjunction keys)
+// or 2/subset (additionally: an entry whose conjunct set is a subset of the scan's conjunct set may prune).
+// In-process, in-memory, empty at process start. Per table (RowGroupCollection) a map
+//   canonical static (plan-time) pushed-down filter conjunction -> per row group {known, has >= 1 qualifying row}.
+// Dynamic filters (join filters, top-N) and OptionalFilters are not part of the key. A row group's bit is recorded
+// only when it was decided: pruned by the static filters' zonemaps / selective statistics, or completely scanned
+// with the whole conjunction evaluated on all its rows (and all rows visible, no updates). A known "no rows" bit
+// lets later scans skip the row group. Any write to the table (append, delete, update, checkpoint, ...) clears the
+// table's entries (epoch). When the variable is unset no state is created.
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/common/common.hpp"
+#include "duckdb/common/atomic.hpp"
+#include "duckdb/common/mutex.hpp"
+#include "duckdb/common/optional_ptr.hpp"
+#include "duckdb/common/unordered_map.hpp"
+#include "duckdb/storage/storage_index.hpp"
+
+namespace duckdb {
+
+class ClientContext;
+class RowGroup;
+class RowGroupCollection;
+class TableFilter;
+class TableFilterSet;
+class PhysicalOperator;
+
+enum class PredicateCacheMode : uint8_t { OFF = 0, EXACT = 1, SUBSET = 2 };
+
+struct PredicateCache {
+	//! PRUNING_PREDICATE_CACHE (evaluated once and cached)
+	static PredicateCacheMode Mode();
+	static bool Enabled() {
+		return Mode() != PredicateCacheMode::OFF;
+	}
+	//! process-wide counters (reported per statement in the PRUNING_STATS_TIMING log)
+	static atomic<uint64_t> scans_cacheable;
+	static atomic<uint64_t> scans_uncacheable;
+	static atomic<uint64_t> pruned;
+	static atomic<uint64_t> recorded_empty;
+	static atomic<uint64_t> recorded_rows;
+	static atomic<uint64_t> conflicts;
+	static atomic<uint64_t> lookup_ns;
+	static atomic<uint64_t> record_ns;
+	static atomic<uint64_t> recheck_ns;
+	static atomic<uint64_t> invalidations;
+	//! current cache size over all tables
+	static atomic<int64_t> entries;
+	static atomic<int64_t> bytes;
+	//! JSON fields for the timing log: ",\"pc_...\":..."
+	static string TimingFields(const uint64_t *start);
+	static void Snapshot(uint64_t *out);
+	static constexpr idx_t SNAPSHOT_SIZE = 10;
+};
+
+struct PredicateCacheEntry {
+	//! canonical key (length-prefixed serialized leaves, sorted) and readable rendering
+	string key;
+	string readable;
+	vector<string> leaves;
+	uint64_t epoch = 0;
+	//! one bit per row group
+	vector<uint64_t> known;
+	vector<uint64_t> has_rows;
+	idx_t Bytes() const {
+		return key.size() + (known.size() + has_rows.size()) * sizeof(uint64_t);
+	}
+};
+
+//! The cache of one table (lives in its RowGroupCollection)
+class PredicateCacheTable {
+public:
+	~PredicateCacheTable();
+	//! any write to the table: all entries become invalid
+	void OnWrite();
+
+	mutex lock;
+	atomic<uint64_t> epoch {1};
+	unordered_map<string, unique_ptr<PredicateCacheEntry>> entries;
+};
+
+//! One table scan (shared by the scan's threads)
+class PredicateCacheScan {
+public:
+	static shared_ptr<PredicateCacheScan> Create(ClientContext &context, RowGroupCollection &collection,
+	                                             const vector<StorageIndex> &storage_ids,
+	                                             optional_ptr<TableFilterSet> filters,
+	                                             optional_ptr<const PhysicalOperator> op, bool sampling,
+	                                             string &info_json);
+	~PredicateCacheScan();
+
+	//! a known "no qualifying row" entry for this row group
+	bool KnownEmpty(idx_t row_group_index) const {
+		return row_group_index < n_row_groups && (known_empty[row_group_index / 64] >> (row_group_index % 64)) & 1;
+	}
+	//! cause: 1 = min/max zonemap, 3 = selective statistic, 4 = this cache
+	void OnPruned(RowGroup &row_group, uint8_t cause);
+	void OnEnter(RowGroup &row_group, idx_t max_row_group_row);
+	void OnSegmentSkip(RowGroup &row_group, idx_t vectors);
+	void OnVector(RowGroup &row_group, idx_t rows_passed, bool all_visible);
+
+	//! JSON object for the pruning counters
+	string InfoJSON() const;
+
+private:
+	struct RowGroupState {
+		//! 0 untouched, 1 pruned (static filters alone prune), 2 entered, 4 pruned by the cache, 5 pruned, but not
+		//! by the static filters alone (unknown)
+		atomic<uint8_t> state;
+		atomic<uint32_t> vectors_total;
+		atomic<uint32_t> vectors_done;
+		atomic<bool> any_rows;
+		atomic<bool> not_all_visible;
+		atomic<uint64_t> count_at_enter;
+	};
+	void Finish();
+	bool StaticFiltersPrune(RowGroup &row_group);
+
+	shared_ptr<PredicateCacheTable> table;
+	string key;
+	string readable;
+	vector<string> leaves;
+	uint64_t epoch = 0;
+	//! the filters applied to rows are exactly the static key filters (no dynamic join filters)
+	bool exact_applied = false;
+	//! the scan has optional or dynamic filters: a pruned row group must be re-checked with the static filters
+	bool needs_recheck = false;
+	//! static non-optional filters per storage column (re-check, update check)
+	vector<std::pair<StorageIndex, unique_ptr<TableFilter>>> static_filters;
+	idx_t n_row_groups = 0;
+	unique_ptr<uint64_t[]> known_empty;
+	idx_t known_empty_at_start = 0;
+	idx_t entries_used = 0;
+	unique_ptr<RowGroupState[]> row_groups;
+
+	PredicateCacheScan() = default;
+};
+
+} // namespace duckdb
diff -ruN a/src/include/duckdb/storage/table/pruning_stats.hpp b/src/include/duckdb/storage/table/pruning_stats.hpp
--- a/src/include/duckdb/storage/table/pruning_stats.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/include/duckdb/storage/table/pruning_stats.hpp	2026-11-17 16:00:28.856779699 +0100
@@ -0,0 +1,141 @@
+//===----------------------------------------------------------------------===//
+//                         DuckDB
+//
+// duckdb/storage/table/pruning_stats.hpp
+//
+// Pruning-opportunity counters (study instrumentation, not part of upstream DuckDB).
+//
+// Enabled only when the environment variable DUCKDB_PRUNING_STATS=<output file> is set. Then, for every scan of a
+// base table, the row groups are classified as pruned (row-group zonemap), scanned without any row satisfying the
+// pushed-down table filters, scanned with >= 1 such row, partially processed / never reached (early stop), and
+// one JSON line per (query, scan) plus one per query is appended to the output file at the end of each query.
+// When the variable is unset no state is created; the only cost is a null-pointer check per row group / vector.
+//===----------------------------------------------------------------------===//
+
+#pragma once
+
+#include "duckdb/common/common.hpp"
+#include "duckdb/common/atomic.hpp"
+#include "duckdb/common/mutex.hpp"
+#include "duckdb/common/types/selection_vector.hpp"
+#include "duckdb/common/types/data_chunk.hpp"
+#include "duckdb/common/column_index.hpp"
+
+namespace duckdb {
+
+class ClientContext;
+class RowGroup;
+class RowGroupCollection;
+class ScanFilterInfo;
+class TableFilter;
+class TableFilterSet;
+class TableCatalogEntry;
+class PhysicalOperator;
+class ExpressionExecutor;
+class Expression;
+
+struct PruningStats {
+	//! Whether counting is enabled (DUCKDB_PRUNING_STATS set and non-empty); evaluated once and cached
+	static bool Enabled();
+	//! Registers the per-connection query state (called from the ClientContext constructor)
+	static void RegisterClientContext(ClientContext &context);
+	//! A base table was bound in the current query (plan-time accounting)
+	static void OnBindTable(ClientContext &context, const string &table_name);
+	//! The physical plan of the current query is about to be executed
+	static void OnPlan(ClientContext &context, const PhysicalOperator &plan);
+};
+
+//! One leaf of a scan's pushed-down filters (column filters are flattened over AND)
+struct PruningLeafFilter {
+	idx_t scan_column_index;
+	string column_name;
+	string column_type;
+	//! constant comparison (=, <, ...), in, or, is_null, optional(...), dynamic_topn, expression, ...
+	string kind;
+	//! static | join | topn
+	string origin;
+	//! false for OptionalFilter (only used for zonemap pruning, never applied to rows)
+	bool applied_to_rows;
+	unique_ptr<TableFilter> filter;
+	//! row groups for which this leaf was the first one (in the engine's check order) proving "no match"
+	atomic<idx_t> pruned_first;
+	//! row groups (among the pruned ones) that this leaf alone could prune
+	atomic<idx_t> prunable_alone;
+	//! same for row groups pruned by selective (additional) statistics after min/max failed: the first leaf whose
+	//! statistic alone proves "no match", and every such leaf
+	atomic<idx_t> pruned_first_additional;
+	atomic<idx_t> prunable_alone_additional;
+};
+
+struct PruningRowGroupStat {
+	//! 0 = never reached, 1 = pruned by the row-group zonemap (min/max), 2 = entered (passed the zonemap check),
+	//! 3 = pruned by a selective (additional) statistic, 4 = pruned by the predicate cache
+	atomic<uint8_t> state;
+	atomic<uint32_t> vectors_total;
+	atomic<uint32_t> vectors_done;
+	atomic<uint32_t> vectors_segment_skipped;
+	atomic<uint64_t> rows_scanned;
+	atomic<uint64_t> rows_passed;
+	atomic<uint64_t> rows_passed_incl_optional;
+};
+
+class PruningScanStats {
+public:
+	static shared_ptr<PruningScanStats> Create(ClientContext &context, TableCatalogEntry &table,
+	                                           RowGroupCollection &collection, const vector<ColumnIndex> &column_indexes,
+	                                           optional_ptr<TableFilterSet> filters,
+	                                           optional_ptr<const PhysicalOperator> op);
+
+	string table_name;
+	idx_t total_rows = 0;
+	idx_t total_row_groups = 0;
+	idx_t scan_id = 0;
+	bool has_filters = false;
+	bool has_optional = false;
+	bool has_dynamic_optional = false;
+	vector<unique_ptr<PruningLeafFilter>> leaves;
+	unique_ptr<PruningRowGroupStat[]> row_groups;
+	atomic<idx_t> pruned_unattributed;
+	atomic<idx_t> out_of_range_row_groups;
+	//! row groups pruned by selective statistics where no single leaf suffices (e.g. a range formed by two leaves)
+	atomic<idx_t> pruned_additional_no_single_leaf;
+	//! per filtered column (scan column index, name): row groups for which it was the first column whose complete
+	//! filter was proven unsatisfiable by its selective statistic
+	vector<idx_t> filter_columns;
+	vector<string> filter_column_names;
+	unique_ptr<atomic<idx_t>[]> additional_first_by_column;
+	//! predicate cache info of this scan (JSON object; empty if the cache is off)
+	string predcache_json;
+
+	string ToJSON(idx_t seq, const string &tag, const string &session) const;
+	PruningRowGroupStat *GetRowGroup(RowGroup &row_group);
+};
+
+//! Per-thread part of a scan (lives in TableScanState); not thread-safe by design
+class PruningScanLocal {
+public:
+	PruningScanLocal(ClientContext &context, shared_ptr<PruningScanStats> stats);
+	~PruningScanLocal();
+
+	void OnPruned(RowGroup &row_group, ScanFilterInfo &filters, bool by_additional = false);
+	void OnPrunedPredicateCache(RowGroup &row_group);
+	void OnEnter(RowGroup &row_group, idx_t max_row_group_row);
+	void OnSegmentSkip(RowGroup &row_group, idx_t vectors);
+	void OnVector(RowGroup &row_group, idx_t rows_scanned, idx_t rows_passed, idx_t rows_passed_incl_optional);
+	//! Number of rows in "result" (already filtered by the non-optional filters) that also satisfy all optional filters
+	idx_t CountOptional(RowGroup &row_group, DataChunk &result, idx_t count);
+
+private:
+	void BuildOptionalExecutor(DataChunk &result);
+
+	ClientContext &context;
+	shared_ptr<PruningScanStats> stats;
+	unique_ptr<Expression> optional_expr;
+	unique_ptr<ExpressionExecutor> optional_executor;
+	DataChunk optional_chunk;
+	vector<idx_t> optional_columns;
+	idx_t optional_row_group = DConstants::INVALID_INDEX;
+	SelectionVector optional_sel;
+};
+
+} // namespace duckdb
