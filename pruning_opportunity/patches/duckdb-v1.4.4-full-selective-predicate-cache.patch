--- a/src/include/duckdb/storage/table/predicate_cache.hpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/include/duckdb/storage/table/predicate_cache.hpp	2026-11-17 16:06:26.050813282 +0100
