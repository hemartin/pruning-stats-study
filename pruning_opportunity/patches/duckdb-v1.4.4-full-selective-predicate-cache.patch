+static const char *PruningStatsPathRaw() {
+	static const char *path = []() -> const char * {
+		auto env = std::getenv("DUCKDB_PRUNING_STATS");
+		if (!env || !*env) {
+			return nullptr;
+		}
+		return env;
+	}();
+	return path;
+}
